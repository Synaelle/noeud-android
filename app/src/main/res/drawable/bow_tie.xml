<?xml version="1.0" encoding="utf-8"?>
<!-- The bow tying itself from the bottom up: the tails rise from their tips to the middle, the
     loops grow out of it, then a small pull. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="112dp"
            android:height="112dp"
            android:viewportWidth="512"
            android:viewportHeight="512">
            <group
                android:name="pull"
                android:pivotX="256"
                android:pivotY="256">
                <group android:translateY="9">
                    <path
                        android:name="tail1"
                        android:pathData="M246,248C232,296 210,330 178,360"
                        android:strokeColor="#E44C3E"
                        android:strokeWidth="52"
                        android:strokeLineCap="round"
                        android:trimPathStart="1" />
                    <path
                        android:name="tail2"
                        android:pathData="M266,248C280,296 302,330 334,360"
                        android:strokeColor="#E44C3E"
                        android:strokeWidth="52"
                        android:strokeLineCap="round"
                        android:trimPathStart="1" />
                    <path
                        android:name="loop1"
                        android:pathData="M240,230C186,120 40,96 40,200C40,290 160,282 240,230"
                        android:strokeColor="#E44C3E"
                        android:strokeWidth="52"
                        android:strokeLineCap="round"
                        android:trimPathEnd="0" />
                    <path
                        android:name="loop2"
                        android:pathData="M272,230C326,120 472,96 472,200C472,290 352,282 272,230"
                        android:strokeColor="#E44C3E"
                        android:strokeWidth="52"
                        android:strokeLineCap="round"
                        android:trimPathEnd="0" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="tail1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="270"
                android:propertyName="trimPathStart"
                android:valueFrom="1"
                android:valueTo="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="tail2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="270"
                android:propertyName="trimPathStart"
                android:valueFrom="1"
                android:valueTo="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="loop1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="270"
                android:duration="630"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="loop2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="270"
                android:duration="630"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="pull">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:startOffset="900"
                    android:duration="240"
                    android:propertyName="scaleX"
                    android:valueFrom="1.06"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:startOffset="900"
                    android:duration="240"
                    android:propertyName="scaleY"
                    android:valueFrom="1.06"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
